# VerityAI Environment Configuration
# Copy to .env and fill in values. Never commit .env to version control.

# =============================================================================
# Database (Docker Compose provides these by default)
# =============================================================================
# POSTGRES_PASSWORD is read by docker-compose.yml for container init.
# The backend's JDBC URL/credentials are set in
# backend/src/main/resources/application.yml (dev default:
# jdbc:postgresql://localhost:5434/verityai, user verityai).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=verityai
POSTGRES_USER=verityai
POSTGRES_PASSWORD=verityai_dev

# =============================================================================
# Application
# =============================================================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# =============================================================================
# Security - Session & CSRF
# =============================================================================
# Generate a strong random value for production: openssl rand -base64 32
SPRING_SESSION_STORE_TYPE=jdbc
SERVER_SERVLET_SESSION_COOKIE_HTTP_ONLY=true
# Set to true behind HTTPS in production (see docs/deployment.md)
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
SERVER_SERVLET_SESSION_COOKIE_SAME_SITE=lax
SERVER_SERVLET_SESSION_TIMEOUT=30m

# CSRF cookie name (Spring Security default is XSRF-TOKEN)
# No additional secret needed for session-based auth

# =============================================================================
# Groq API
# =============================================================================
# Get your key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_CONNECT_TIMEOUT_MS=10000
GROQ_READ_TIMEOUT_MS=60000
GROQ_MAX_RETRIES=2
GROQ_MAX_TOKENS=4096

# =============================================================================
# AI Summaries (document intelligence)
# =============================================================================
# Leave SUMMARY_MODEL empty to reuse GROQ_MODEL for summaries.
SUMMARY_MODEL=
SUMMARY_ENABLED=true
# Docs longer than this use hierarchical segment condensation
SUMMARY_SINGLE_PASS_CHARS=48000
SUMMARY_MAX_SEGMENTS=8
# Budgets must accommodate reasoning-token usage of models like gpt-oss,
# which routinely spend 2000+ reasoning tokens before emitting content.
SUMMARY_MAX_TOKENS=8000
SUMMARY_SEGMENT_MAX_TOKENS=8000
# Max automatic summary backfills per application start
SUMMARY_BACKFILL_LIMIT=20

# =============================================================================
# Embeddings (Phase 2: local semantic search)
# =============================================================================
# onnx = local MiniLM model via ONNX Runtime (no external embedding API);
# off  = keyword-only retrieval (no embeddings, no model download).
EMBEDDINGS_PROVIDER=onnx
# First run downloads the model+tokenizer from Hugging Face, verifies the
# SHA-256 pins in application.yml, and caches them here for offline reuse.
EMBEDDINGS_CACHE_DIR=~/.verityai/models
EMBEDDINGS_MAX_INPUT_CHARS=2000
EMBEDDINGS_CONNECT_TIMEOUT_MS=10000
EMBEDDINGS_READ_TIMEOUT_MS=60000
EMBEDDINGS_DOWNLOAD_TIMEOUT_MS=180000

# =============================================================================
# Retrieval & search (Phase 2: hybrid retrieval)
# =============================================================================
# false = keyword-only retrieval, identical to pre-Phase-2 behavior
RETRIEVAL_HYBRID=true
# Reciprocal Rank Fusion constant (higher = flatter fusion)
RETRIEVAL_RRF_K=60
# Minimum cosine similarity for a semantic candidate (0..1)
RETRIEVAL_MIN_SIMILARITY=0.10
# Hard cap / default for POST /search results
SEARCH_MAX_RESULTS=30
SEARCH_DEFAULT_RESULTS=20

# =============================================================================
# Claim verification (Phase 2: citation verification endpoint)
# =============================================================================
# on/off for claim-level verification of assistant answers (Feature 6)
VERIFY_ENABLED=true
# Optional dedicated model; empty = GROQ_MODEL
VERIFY_MODEL=
VERIFY_MAX_CLAIMS=25
VERIFY_MAX_TOKENS=2500

# =============================================================================
# Knowledge graph (Phase 3: deterministic, PostgreSQL only)
# =============================================================================
# No external graph database and no model call; entities are extracted from
# document chunks and merged with the summary ENTITIES section when present.
KNOWLEDGE_GRAPH_ENABLED=true
# Max documents rebuilt by the asynchronous startup backfill
KNOWLEDGE_GRAPH_BACKFILL_LIMIT=20
# Max documents rebuilt by one explicit POST /knowledge-graph/rebuild
KNOWLEDGE_GRAPH_REBUILD_MAX_DOCUMENTS=10
# Response caps (keep the SVG graph and JSON payload bounded)
KNOWLEDGE_GRAPH_MAX_NODES=300
KNOWLEDGE_GRAPH_MAX_EDGES=4000

# =============================================================================
# File Storage
# =============================================================================
# Directory outside web root for uploaded PDFs
# (dev profile overrides this with a temp directory)
UPLOAD_DIR=/var/lib/verityai/uploads
MAX_FILE_SIZE_MB=25
MAX_PAGES=200

# =============================================================================
# Document Processing
# =============================================================================
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_RANK=0.1

# =============================================================================
# Rate Limiting (per-user/in-memory)
# =============================================================================
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=20
RATE_LIMIT_UPLOADS_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_MINUTE_IP=5

# =============================================================================
# Frontend (Vite)
# =============================================================================
VITE_API_BASE_URL=http://localhost:8080/api/v1
